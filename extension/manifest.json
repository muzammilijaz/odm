{
  "manifest_version": 3,
  "name": "ODM - Open Download Manager",
  "version": "1.0.0",
  "description": "Send videos, audio, and downloads to ODM -- a free, open-source manager with fast multi-connection downloading.",
  "author": "Muzammil Ijaz",
  "homepage_url": "https://github.com/muzammilijaz/odm",
  "permissions": ["contextMenus", "webRequest", "storage", "nativeMessaging", "downloads"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ODM - Open Download Manager",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
