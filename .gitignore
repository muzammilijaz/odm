# Rust / Cargo
/target/
**/target/

# Node / frontend
node_modules/
dist/
dist-ssr/
*.local

# Tauri build output
desktop/src-tauri/target/
desktop/src-tauri/gen/

# Third-party sidecar binaries (ffmpeg suite, yt-dlp, quickjs) -- ~180MB of
# redistributable binaries that don't belong in source control. See
# desktop/src-tauri/binaries/README.md for how to fetch them locally.
desktop/src-tauri/binaries/*
!desktop/src-tauri/binaries/README.md

# VC++ redistributable bundled into the installer -- ~24MB, fetched fresh at
# build time (see desktop/src-tauri/resources/README.md) rather than
# committed, same reasoning as the sidecar binaries above.
#
# resources/extension/ is likewise generated (by stage-extension.ps1, run
# automatically via tauri.conf.json's beforeBundleCommand) -- a copy of
# extension/'s browser-loadable files, not a separate source of truth.
desktop/src-tauri/resources/*
!desktop/src-tauri/resources/README.md

# NSIS build output
desktop/src-tauri/target/release/bundle/

# Extension packaging output -- rebuilt from source, attached to GitHub
# Releases rather than committed to the tree.
extension/odm-extension.zip
extension/odm-extension.crx

# Generated by install-native-host.ps1 -- bakes in an absolute path specific
# to the machine it was installed on.
extension/native-host-manifest/com.odm.nativehost.installed.json

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Secrets -- the extension's private signing key. NEVER commit these; only
# the derived public key (baked into extension/manifest.json's "key" field)
# is meant to be shared. See keys/README.md for how to regenerate locally.
keys/key.pem
keys/key.der
